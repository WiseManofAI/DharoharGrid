# Supabase — same project as AI Backend / Spatial Backend
SUPABASE_URL=
SUPABASE_KEY=

# Pluggable LLM — any OpenAI-compatible /chat/completions endpoint.
# Defaults to Groq. To use a different provider, change these three.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Embedding model — must match the AI Backend's EMBEDDING_MODEL_NAME so
# query embeddings and node embeddings live in the same vector space.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Pipeline tuning (defaults shown)
SYNAPSE_TOP_K=6
SYNAPSE_MIN_COSINE=0.35
SYNAPSE_BATCH_SIZE=5
DEDUPE_COSINE_THRESHOLD=0.93
GRAPH_CACHE_TTL_SECONDS=300

CORS_ALLOW_ORIGINS=*
