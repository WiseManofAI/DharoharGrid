# Phase 2 — Supabase credentials.
# Copy this file to .env and fill in your project's values
# (Supabase dashboard -> Project Settings -> API).
#
# Without these set, the app falls back to local mock graph data
# (src/lib/mockData.js) so the UI still runs and is fully clickable.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
